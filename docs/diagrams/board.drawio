"373.462" width="25.875" height="25.875" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=0;fillColor=#60646E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="36" y="460" width="172.5" height="2" as="geometry"/></mxCell><mxCell id="c53" value="10 mm   (24 x 24 mm)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="214.5" y="448" width="200" height="24" as="geometry"/></mxCell><mxCell id="c54" value="&lt;font style=&quot;font-size: 30px&quot;&gt;&lt;b&gt;M5Stack ATOM Echo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#60646E&quot;&gt;M5Stack&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin: 0 0 0 18px; padding: 0&quot;&gt;&lt;li&gt;ESP32-PICO-D4 (Xtensa LX6 dual core, 240 MHz), 520 KB SRAM, 4 MB flash&lt;/li&gt;&lt;li&gt;SPM1423 PDM microphone, NS4168 I2S speaker, SK6812 RGB LED, one button&lt;/li&gt;&lt;li&gt;24 mm cube; USB-C with a CH552/FTDI USB-UART&lt;/li&gt;&lt;li&gt;Flash: esptool over the USB-UART (west flash --esp-device COMx)&lt;/li&gt;&lt;li&gt;Console: UART0 on the same port, JSON lines for the Home Assistant bridge&lt;/li&gt;&lt;li&gt;This repo: &quot;hey zephyr&quot; wake word, MFCC + DS-CNN via ExecuTorch&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="650" height="400" as="geometry"/></mxCell><mxCell id="c55" value="Silhouette drawn to scale from the board's dimensions; not a photo. Edit this file in draw.io." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="650" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>